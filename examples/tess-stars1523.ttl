# OAKE non-normative example: TESS-W photometer stars1523
#
# This example reuses external semantic resources and includes one real
# observation exported from the STARS4ALL/TESS Grafana data supplied for
# stars1523.
#
# The CSV does not state the timezone of the exported "Time" column.
# The timestamp is therefore preserved exactly as exported, without
# asserting a UTC offset.
#
# The same CSV row also contains:
#   tamb = 15.33
#   tsky = -1.35
# These temperature values are intentionally not modelled yet, pending
# selection of a precise semantic pattern distinguishing ambient and sky
# temperature.

@prefix ex:     <https://w3id.org/astrosemantics/oake/examples/tess/> .
@prefix geo:    <http://www.opengis.net/ont/geosparql#> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix saref:  <https://saref.etsi.org/core/> .
@prefix s4envi: <https://saref.etsi.org/saref4envi/> .
@prefix sosa:   <http://www.w3.org/ns/sosa/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .


# ---------------------------------------------------------------------------
# Individual device
# ---------------------------------------------------------------------------

ex:stars1523
    a saref:Sensor , sosa:Sensor ;
    rdfs:label "TESS-W stars1523"@en ;
    saref:hasIdentifier "stars1523" ;
    saref:hasDeviceKind s4envi:TESS ;
    saref:hasModel "TESS-W" ;
    saref:observes s4envi:LightMagnitude ;
    sosa:hasDeployment ex:stars1523-deployment-2025 .


# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

ex:stars1523-deployment-2025
    a sosa:Deployment ;
    rdfs:label "Deployment of stars1523 at Kergreach"@en ;
    sosa:deployedSystem ex:stars1523 ;
    sosa:startTime "2025-12-01"^^xsd:date ;
    geo:hasGeometry [
        a geo:Geometry ;
        geo:asWKT "POINT (-4.398 48.498)"^^geo:wktLiteral
    ] .


# ---------------------------------------------------------------------------
# Unit used by the TESS sky-brightness measurement
# ---------------------------------------------------------------------------

ex:MAG-PER-ARCSEC2
    a qudt:Unit ;
    rdfs:label "magnitude per square arcsecond"@en ;
    qudt:symbol "mag/arcsec²" ;
    qudt:expression "mag.arcsec**-2" .


# ---------------------------------------------------------------------------
# One real observation from the supplied stars1523 export
# ---------------------------------------------------------------------------

ex:obs-stars1523-20260913T000132
    a sosa:Observation ;
    rdfs:label "stars1523 sky-brightness observation at 2026-09-13T00:01:32"@en ;
    sosa:madeBySensor ex:stars1523 ;
    sosa:observedProperty s4envi:LightMagnitude ;
    sosa:hasResult [
        a qudt:QuantityValue ;
        qudt:value 21.05 ;
        qudt:hasUnit ex:MAG-PER-ARCSEC2
    ] ;
    sosa:resultTime "2026-09-13T00:01:32"^^xsd:dateTime .

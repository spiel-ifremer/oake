# OAKE non-normative example: AllSky installation at Kergreach
#
# This example uses external semantic resources only.
#
# Identity rule:
# - ex:allsky-kersaint-plabennec is the stable knowledge-graph identity
#   of the observing system used in this OAKE example.
# - external technical identifiers such as an Allsky Map `machine_id`
#   are intentionally NOT asserted here until their exact scope has been
#   verified.
# - a camera serial number, Raspberry Pi identifier, software-installation
#   identifier or Allsky Map registration identifier must not be treated
#   automatically as the identifier of the persistent observing system.
#
# The example distinguishes:
# - the persistent identity of the AllSky observing system;
# - its first known technical configuration;
# - the physical and software components of that configuration;
# - deployment at the same Kergreach place used by stars1523;
# - and the public web page from the physical observing system.
#
# The field of view is intentionally not asserted because it has not yet
# been characterised precisely.

@prefix ex:      <https://w3id.org/astrosemantics/oake/examples/allsky/> .
@prefix place:   <https://w3id.org/astrosemantics/oake/examples/place/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo:     <http://www.opengis.net/ont/geosparql#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix saref:   <https://saref.etsi.org/core/> .
@prefix s4syst:  <https://saref.etsi.org/saref4syst/> .
@prefix schema:  <https://schema.org/> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix unit:    <http://qudt.org/vocab/unit/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .


# ---------------------------------------------------------------------------
# Shared observing place
# ---------------------------------------------------------------------------

place:kergreach-observing-place
    a geo:Feature , dcterms:Location ;
    rdfs:label "Kergreach observing place"@en ;
    geo:hasGeometry place:kergreach-observing-place-geometry .

place:kergreach-observing-place-geometry
    a geo:Geometry ;
    geo:asWKT "POINT (-4.398 48.498)"^^geo:wktLiteral .


# ---------------------------------------------------------------------------
# Persistent observing-system identity
# ---------------------------------------------------------------------------

ex:allsky-kersaint-plabennec
    a sosa:System , s4syst:System , prov:Entity ;
    rdfs:label "AllSky observing system at Kergreach"@en ;
    sosa:hasDeployment ex:allsky-deployment-2026 .

# No machine_id is asserted here. If an Allsky Map identifier is later
# verified to identify an external registration or software installation
# rather than the persistent observing system itself, that registration
# should be represented as a separate resource carrying its own identifier.


# ---------------------------------------------------------------------------
# First known technical configuration
# ---------------------------------------------------------------------------

ex:allsky-config-2026-09-05
    a sosa:System , s4syst:System , prov:Entity ;
    rdfs:label "AllSky configuration from 2026-09-05"@en ;
    prov:specializationOf ex:allsky-kersaint-plabennec ;
    dcterms:date "2026-09-05"^^xsd:date ;
    s4syst:hasSubSystem ex:zwo-asi678mc , ex:raspberry-pi-5 ;
    dcterms:hasPart ex:fisheye-lens-2-5mm , ex:allsky-software .

# When the lens is replaced, this configuration should remain in the graph.
# A new configuration entity should be created and linked to the same
# persistent observing-system identity with prov:specializationOf.
# If the exact change timestamp is known, PROV generation/invalidation
# times may then be added using xsd:dateTime values.


# ---------------------------------------------------------------------------
# Physical and software components
# ---------------------------------------------------------------------------

ex:zwo-asi678mc
    a saref:Sensor , sosa:Sensor , s4syst:System , prov:Entity ;
    rdfs:label "ZWO ASI678MC camera"@en ;
    saref:hasManufacturer "ZWO" ;
    saref:hasModel "ASI678MC" .

ex:fisheye-lens-2-5mm
    a prov:Entity ;
    rdfs:label "2.5 mm fisheye lens"@en .

ex:raspberry-pi-5
    a saref:Device , s4syst:System , prov:Entity ;
    rdfs:label "Raspberry Pi 5 Model B, 16 GB"@en ;
    saref:hasModel "Raspberry Pi 5 Model B" .

ex:allsky-software
    a schema:SoftwareApplication , prov:Entity ;
    schema:name "Allsky" ;
    rdfs:label "Allsky software"@en .


# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

ex:allsky-deployment-2026
    a sosa:Deployment ;
    rdfs:label "Deployment of the AllSky system at Kergreach"@en ;
    sosa:deployedSystem ex:allsky-kersaint-plabennec ;
    sosa:startTime "2026-09-05"^^xsd:date ;
    dcterms:spatial place:kergreach-observing-place .


# ---------------------------------------------------------------------------
# Public web access
# ---------------------------------------------------------------------------

ex:allsky-public-page
    a schema:WebPage ;
    schema:name "Kersaint-Plabennec AllSky" ;
    schema:url <https://allsky.tail01e8e7.ts.net/allsky/> ;
    schema:about ex:allsky-kersaint-plabennec .

# ---------------------------------------------------------------------------
# One real AllSky acquisition
# ---------------------------------------------------------------------------

# Acquisition metadata visible on the public Allsky page:
#   timestamp = 2026-09-14 06:50:56 UTC
#   exposure  = 768 us (0.768 ms)
#   gain      = 0
#
# IVOA Provenance DM 1.0 explicitly allows activity configuration to be
# represented using entities connected to the activity through Used
# relations with a setup/configuration role. This RDF example follows
# that generic PROV-O-compatible pattern rather than inventing
# OAKE-specific exposure or gain properties.
#
# The specialised IVOA ActivityConfiguration package is a VO-DML model.
# It is therefore used here as a conceptual alignment rather than by
# minting unverified RDF properties in an IVOA namespace.
#
# The exposure value also corresponds conceptually to ObsCore t_exptime.
# No ObsCore RDF property is asserted here because this example has not
# adopted a canonical RDF serialization of ObsCore.
#
# FITS/WCS metadata are not asserted because the current example does not
# yet contain verified WCS information for this image.

ex:sky-observed-from-kergreach
    a sosa:FeatureOfInterest ;
    rdfs:label "Sky observed from Kergreach"@en .


# ---------------------------------------------------------------------------
# Acquisition configuration values
# ---------------------------------------------------------------------------

ex:setup-configuration-role
    a prov:Role ;
    rdfs:label "Acquisition setup parameter"@en .

ex:observing-configuration-role
    a prov:Role ;
    rdfs:label "Observing-system configuration"@en .

ex:exposure-setting-20260914T065056Z
    a prov:Entity , qudt:QuantityValue ;
    rdfs:label "Exposure time setting for the 2026-09-14 06:50:56 UTC acquisition"@en ;
    qudt:numericValue "0.000768"^^xsd:decimal ;
    qudt:unit unit:SEC .

ex:gain-setting-20260914T065056Z
    a prov:Entity ;
    rdfs:label "Camera gain setting for the 2026-09-14 06:50:56 UTC acquisition"@en ;
    prov:value "0"^^xsd:integer .


# ---------------------------------------------------------------------------
# Observation / acquisition activity
# ---------------------------------------------------------------------------

ex:allsky-observation-20260914T065056Z
    a sosa:Observation , prov:Activity ;
    rdfs:label "AllSky image acquisition at 2026-09-14 06:50:56 UTC"@en ;

    # SOSA identifies the actual observational sensor: the ASI678MC camera.
    sosa:madeBySensor ex:zwo-asi678mc ;
    sosa:hasFeatureOfInterest ex:sky-observed-from-kergreach ;
    sosa:hasResult ex:allsky-image-20260914T065056Z ;
    sosa:resultTime "2026-09-14T06:50:56Z"^^xsd:dateTime ;

    # PROV-O connects the acquisition to the complete technical
    # configuration and to the concrete parameter values used.
    prov:used
        ex:allsky-config-2026-09-05 ,
        ex:exposure-setting-20260914T065056Z ,
        ex:gain-setting-20260914T065056Z ;

    prov:qualifiedUsage [
        a prov:Usage ;
        prov:entity ex:allsky-config-2026-09-05 ;
        prov:hadRole ex:observing-configuration-role
    ] ;

    prov:qualifiedUsage [
        a prov:Usage ;
        prov:entity ex:exposure-setting-20260914T065056Z ;
        prov:hadRole ex:setup-configuration-role
    ] ;

    prov:qualifiedUsage [
        a prov:Usage ;
        prov:entity ex:gain-setting-20260914T065056Z ;
        prov:hadRole ex:setup-configuration-role
    ] .


# ---------------------------------------------------------------------------
# Generated image resource
# ---------------------------------------------------------------------------

ex:allsky-image-20260914T065056Z
    a schema:ImageObject , prov:Entity ;
    rdfs:label "AllSky image acquired at 2026-09-14 06:50:56 UTC"@en ;
    dcterms:created "2026-09-14T06:50:56Z"^^xsd:dateTime ;
    prov:wasGeneratedBy ex:allsky-observation-20260914T065056Z .
